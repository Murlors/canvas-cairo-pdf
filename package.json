{
  "name": "canvas-cairo-pdf",
  "description": "Canvas drawing commands to Cairo/Pango PDF with document adapters",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": { "node": ">=24.12.0" },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "vp pack && node scripts/build.ts",
    "build:browser": "vp pack",
    "build:reference": "bun scripts/build-pliflo-reference.ts",
    "check": "vp check browser scripts tests vite.config.ts && cargo fmt --all -- --check && cargo test --workspace",
    "test": "vp test run && node scripts/check-ooxml-runtime.ts && node scripts/check-pdf.ts",
    "test:lifecycle": "node scripts/check-prepare.ts && node scripts/check-recovery.ts",
    "render": "node scripts/run-pages.ts"
  },
  "dependencies": {
    "@silurus/ooxml": "0.87.0",
    "pdf-lib": "1.17.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Murlors/canvas-cairo-pdf.git"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite-plus": "0.3.2"
  }
}
